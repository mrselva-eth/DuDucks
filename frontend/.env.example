# Frontend Environment Variables for DuDucks

# Web3 & Wallet Configuration (Reown / WalletConnect Cloud)
# Get your project ID at https://cloud.reown.com
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=your_reown_project_id_here

# DigiLocker OAuth
NEXT_PUBLIC_DIGILOCKER_CLIENT_ID=your_digilocker_client_id_here
NEXT_PUBLIC_DIGILOCKER_REDIRECT_URI=http://localhost:3000/verify
DIGILOCKER_CLIENT_SECRET=your_digilocker_client_secret_here

# Base Sepolia RPC
NEXT_PUBLIC_BASE_SEPOLIA_RPC=https://sepolia.base.org
NEXT_PUBLIC_BASE_SEPOLIA_CHAIN_ID=84532

# Relayer Configuration
NEXT_PUBLIC_RELAYER_URL=http://localhost:3001
NEXT_PUBLIC_RELAYER_API_KEY=your_relayer_api_key_here

# Verification Contract Address
NEXT_PUBLIC_VERIFICATION_CONTRACT_ADDRESS=0x

# ZK Proof Configuration
NEXT_PUBLIC_CIRCUIT_NAME=aadhaar-verification
NEXT_PUBLIC_PROOF_TYPE=groth16

# Feature Flags
NEXT_PUBLIC_ENABLE_TESTNET=true
NEXT_PUBLIC_DEBUG_MODE=false
