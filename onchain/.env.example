# DuDucks Onchain Environment Variables

# ===== BLOCKCHAIN RPC =====
# Base Sepolia Testnet RPC URL
BASE_SEPOLIA_RPC=https://sepolia.base.org

# ===== WALLET PRIVATE KEYS =====
# Private key of the relayer account (signer for all transactions)
PRIVATE_KEY_RELAYER=your_relayer_private_key_here

# ===== ADMIN ADDRESSES =====
# Admin address for contract administration
ADMIN_ADDRESS=0x0000000000000000000000000000000000000000

# ===== BLOCK EXPLORER =====
# BaseScan API key for contract verification
BASESCAN_API_KEY=your_basescan_api_key_here

# ===== RELAYER CONFIG =====
# Relayer service URL for submitting proofs
RELAYER_URL=http://localhost:3001
RELAYER_ADDRESS=0x0000000000000000000000000000000000000000

# ===== DEPLOYED CONTRACTS =====
# After deployment, fill these in
VERIFICATION_REGISTRY_ADDRESS=
GROTH16_VERIFIER_ADDRESS=

# ===== TESTING =====
# Local test network port (for anvil)
ANVIL_PORT=8545
ANVIL_CHAIN_ID=84532
